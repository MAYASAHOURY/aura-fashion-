rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Moodboard items ──────────────────────────────────────
    // Only the authenticated owner can read or write their items.
    // Writes are validated: must include required fields, correct types,
    // and the item ID in the document must match the path segment.
    match /moodboards/{userId}/items/{itemId} {
      allow read:   if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.id   is string
        && request.resource.data.img  is string
        && request.resource.data.id   == itemId
        && request.resource.data.img.size() > 0;
    }

    // ── User profiles (quiz results, settings, Google profile) ─
    // Owner-only. Writes validated:
    //   - quizResult, if present, must have id + name (string)
    //   - profile fields, if present, must be the expected types
    //   - uid (if set) must match the path uid (no impersonation)
    //   - lastLoginAt / createdAt (if set) must be a server-side timestamp
    // Reads / writes are otherwise free-form so quiz / moodboard / likes
    // metadata can evolve without rule changes.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && (!('quizResult' in request.resource.data)
            || (request.resource.data.quizResult.id   is string
             && request.resource.data.quizResult.name is string))
        && (!('uid'          in request.resource.data) || request.resource.data.uid          == userId)
        && (!('email'        in request.resource.data) || request.resource.data.email        is string
                                                       || request.resource.data.email        == null)
        && (!('displayName'  in request.resource.data) || request.resource.data.displayName  is string
                                                       || request.resource.data.displayName  == null)
        && (!('photoURL'     in request.resource.data) || request.resource.data.photoURL     is string
                                                       || request.resource.data.photoURL     == null)
        && (!('authProvider' in request.resource.data) || request.resource.data.authProvider is string)
        && (!('onboardingCompleted' in request.resource.data) || request.resource.data.onboardingCompleted is bool)
        && (!('createdAt'    in request.resource.data) || request.resource.data.createdAt    is timestamp)
        && (!('lastLoginAt'  in request.resource.data) || request.resource.data.lastLoginAt  is timestamp);
    }

    // ── Error logs ───────────────────────────────────────────
    // Any authenticated user can create error entries.
    // Nobody can read, update, or delete via client SDK.
    match /errors/{errorId} {
      allow create: if request.auth != null
        && request.resource.data.message is string
        && request.resource.data.ts      is string;
      allow read, update, delete: if false;
    }

    // ── Posts — read-only from client; writes via Admin SDK only ─
    match /posts/{postId} {
      allow read:  if true;
      allow write: if false;

      // ── Likes subcollection ─────────────────────────────────
      match /likes/{userId} {

        // Anyone can read (needed for like count + UI state)
        allow read: if true;

        // CREATE — authenticated user, own UID, exact fields, valid timestamp
        allow create: if request.auth != null
          && request.auth.uid                      == userId
          && request.resource.data.userId          == userId
          && request.resource.data.postId          == postId
          && request.resource.data.keys().hasOnly(['userId', 'postId', 'createdAt'])
          && request.resource.data.createdAt       is timestamp;

        // DELETE — unlike, owner only
        allow delete: if request.auth != null
          && request.auth.uid == userId;

        // UPDATE — never (document is immutable once created)
        allow update: if false;
      }
    }

    // ── Block everything else ────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
